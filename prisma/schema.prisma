// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLEADOR
  ESPECIALISTA
}

// Estados del ciclo de vida de una cuenta (BACK-03):
// INACTIVO -> PENDIENTE_VALIDACION (datos + KYC completos) -> ACTIVO (aprobación manual, BACK-11)
enum UserStatus {
  INACTIVO
  PENDIENTE_VALIDACION
  ACTIVO
}

// Estados de validación de documentos que respaldan un conocimiento (BACK-04)
enum DocumentVerificationStatus {
  PENDING
  VALIDATED
  REJECTED
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  name               String?
  role               Role       @default(EMPLEADOR)
  status             UserStatus @default(INACTIVO)
  twoFactorCode      String?
  twoFactorExpiresAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profile    Profile?
  knowledges    Knowledge[]
  catalogImages CatalogImage[]
  wallet        Wallet?
  employerRooms   ChatRoom[] @relation("EmployerRooms")
  specialistRooms ChatRoom[] @relation("SpecialistRooms")
  sentMessages    Message[]  @relation("UserSentMessages")

  @@map("users")
}

// Datos personales y documentos de identidad (KYC) del usuario
model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String?
  phone      String?
  address    String?
  postalCode String?
  ineUrl     String?
  selfieUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("profiles")
}

// Conocimientos/oficios que un ESPECIALISTA sabe realizar
model Knowledge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  verifications DocumentVerification[]

  @@index([userId])

  @@map("knowledges")
}

// Documento (diploma/certificado) subido para respaldar un conocimiento.
// El motor de IA/OCR (BACK-04) procesa el archivo y actualiza `status`.
model DocumentVerification {
  id          String                   @id @default(uuid())
  knowledgeId String
  knowledge   Knowledge                @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  fileUrl     String
  status      DocumentVerificationStatus @default(PENDING)
  provider    String?
  score       Float?
  reason      String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([knowledgeId])
  @@index([status])

  @@map("document_verifications")
}

// Catálogo de Trabajos / Galería de Fotografías del Especialista (BACK-06)
model CatalogImage {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl    String    @map("image_url")
  title       String    @db.VarChar(100)
  description String?   @db.VarChar(300)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("catalog_images")
}

// Catálogo Maestro Nacional de Códigos Postales SEPOMEX (BACK-05)
// Fuente oficial del Servicio Postal Mexicano (Correos de México)
model SepomexPostalCode {
  id             Int     @id @default(autoincrement())
  postalCode     String  @map("d_codigo") @db.VarChar(10)
  asentamiento   String  @map("d_asenta") @db.VarChar(150)
  tipoAsenta     String? @map("d_tipo_asenta") @db.VarChar(60)
  municipio      String  @map("d_mnpio") @db.VarChar(100)
  estado         String  @map("d_estado") @db.VarChar(60)
  ciudad         String? @map("d_ciudad") @db.VarChar(100)
  dCp            String? @map("d_cp") @db.VarChar(10)
  cEstado        String? @map("c_estado") @db.VarChar(10)
  cOficina       String? @map("c_oficina") @db.VarChar(10)
  cCp            String? @map("c_cp") @db.VarChar(10)
  cTipoAsenta    String? @map("c_tipo_asenta") @db.VarChar(10)
  cMnpio         String? @map("c_mnpio") @db.VarChar(10)
  idAsentaCpcons String? @map("id_asenta_cpcons") @db.VarChar(10)
  zona           String? @map("d_zona") @db.VarChar(30)
  cCveCiudad     String? @map("c_cve_ciudad") @db.VarChar(10)

  @@index([postalCode])
  @@index([municipio])
  @@index([estado])
  @@map("sepomex_postal_codes")
}

// Sala privada de chat entre un Empleador y un Especialista (BACK-07)
model ChatRoom {
  id           String    @id @default(uuid())
  employerId   String    @map("employer_id")
  specialistId String    @map("specialist_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employer   User      @relation("EmployerRooms", fields: [employerId], references: [id], onDelete: Cascade)
  specialist User      @relation("SpecialistRooms", fields: [specialistId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([employerId, specialistId])
  @@index([employerId])
  @@index([specialistId])
  @@map("chat_rooms")
}

// Mensaje intercambiado dentro de una sala de chat (BACK-07)
model Message {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  senderId  String   @map("sender_id")
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// Tipos de transacciones monetarias en la Billetera (BACK-08)
enum TransactionType {
  RECARGA
  PAGO
  CONGELAMIENTO
  DEVOLUCION
}

// Billetera Virtual del Especialista (BACK-08)
model Wallet {
  id                String        @id @default(uuid())
  userId            String        @unique @map("user_id")
  balanceDisponible Decimal       @default(0.0) @map("balance_disponible") @db.Decimal(12, 2)
  balanceCongelado  Decimal       @default(0.0) @map("balance_congelado") @db.Decimal(12, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@map("wallets")
}

// Historial de movimientos / transacciones de la Billetera (BACK-08)
model Transaction {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  monto       Decimal         @map("monto") @db.Decimal(12, 2)
  tipo        TransactionType @map("tipo")
  descripcion String?         @map("descripcion") @db.VarChar(255)
  fecha       DateTime        @default(now()) @map("fecha")

  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([tipo])
  @@index([fecha])
  @@map("transactions")
}
