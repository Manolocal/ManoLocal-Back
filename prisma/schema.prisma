// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLEADOR
  ESPECIALISTA
}

// Estados del ciclo de vida de una cuenta (BACK-03):
// INACTIVO -> PENDIENTE_VALIDACION (datos + KYC completos) -> ACTIVO (aprobación manual, BACK-11)
enum UserStatus {
  INACTIVO
  PENDIENTE_VALIDACION
  ACTIVO
}

// Estados de validación de documentos que respaldan un conocimiento (BACK-04)
enum DocumentVerificationStatus {
  PENDING
  VALIDATED
  REJECTED
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  name               String?
  role               Role       @default(EMPLEADOR)
  status             UserStatus @default(INACTIVO)
  twoFactorCode      String?
  twoFactorExpiresAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profile    Profile?
  knowledges Knowledge[]

  @@map("users")
}

// Datos personales y documentos de identidad (KYC) del usuario
model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String?
  phone      String?
  address    String?
  postalCode String?
  ineUrl     String?
  selfieUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("profiles")
}

// Conocimientos/oficios que un ESPECIALISTA sabe realizar
model Knowledge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  verifications DocumentVerification[]

  @@index([userId])

  @@map("knowledges")
}

// Documento (diploma/certificado) subido para respaldar un conocimiento.
// El motor de IA/OCR (BACK-04) procesa el archivo y actualiza `status`.
model DocumentVerification {
  id          String                   @id @default(uuid())
  knowledgeId String
  knowledge   Knowledge                @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  fileUrl     String
  status      DocumentVerificationStatus @default(PENDING)
  provider    String?
  score       Float?
  reason      String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([knowledgeId])
  @@index([status])

  @@map("document_verifications")
}
