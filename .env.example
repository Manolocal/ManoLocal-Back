# Conexión con Supabase PostgreSQL
# Pooler de conexiones (Transaction Mode - puerto 6543) para consultas de la aplicación
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (Direct Connection - puerto 5432) para migraciones con Prisma CLI
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Puerto de la aplicación
PORT=3000

# Seguridad JWT
JWT_SECRET="super-secret-key-change-in-production"
JWT_EXPIRES_IN="1d"

# Supabase Storage (subida de archivos: INE, Selfie, fotos de catálogo, etc.)
# Usar la clave de SERVICE_ROLE (server-side), nunca la anon key.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_STORAGE_BUCKET="kyc"

# Configuración de Correo (Nodemailer / SMTP para envío de 2FA PIN)
# Si no se definen, el MailService registrará el PIN en la consola (modo desarrollo).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="ManoLocal <no-reply@manolocal.com>"
